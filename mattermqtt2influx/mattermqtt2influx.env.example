# Copy to mattermqtt2influx.env (next to the script) and fill in.
# Loaded by the systemd unit; keep it root-readable only (chmod 600).

MQTT_HOST=127.0.0.1
#MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
#MQTT_TOPIC=matter/airquality/#

INFLUX_URL=http://127.0.0.1:8086
INFLUX_ORG=my-org
INFLUX_BUCKET=airquality
INFLUX_TOKEN=changeme
