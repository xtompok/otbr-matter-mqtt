[Unit]
Description=Matter air quality MQTT data to InfluxDB
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mattermqtt2influx
EnvironmentFile=%h/mattermqtt2influx/mattermqtt2influx.env
ExecStart=/usr/bin/python3 %h/mattermqtt2influx/mattermqtt2influx.py
Restart=always
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
