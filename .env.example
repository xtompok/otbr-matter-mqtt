# Copy to .env for docker-compose CLI use; in Portainer set these as
# stack environment variables instead.

# REQUIRED: MQTT broker to publish to. The bridge runs in an isolated
# namespace, so 127.0.0.1 would NOT be the host. Use:
#   host.docker.internal  - broker on the docker host itself (must listen on
#                           0.0.0.0, e.g. a published container port)
#   mosquitto             - the bundled broker (COMPOSE_PROFILES=broker)
#   a LAN address/hostname - broker elsewhere
MQTT_HOST=host.docker.internal
#MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
#MQTT_TOPIC_PREFIX=airquality

# Serial device of the ESP32-C6 RCP. The default (in docker-compose.yml) is the
# by-id path of the already-flashed board, stable across machines and reboots.
#OTBR_SERIAL_DEVICE=/dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_58:E6:C5:14:0E:00-if00

# Where persistent state lives on the host. Use an ABSOLUTE path with Portainer
# so state survives stack redeploys. Default: ./data next to the compose file.
#DATA_DIR=/opt/airquality/data

# Uncomment (or set in Portainer) to also run the bundled mosquitto broker,
# published on host port 1883 — the stack's only published port.
#COMPOSE_PROFILES=broker
